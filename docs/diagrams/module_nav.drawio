<mxfile host="app.diagrams.net" modified="2026-03-29T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="nav-module" name="nav/ — 导航 bit 归一化与循环访问">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="760" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
