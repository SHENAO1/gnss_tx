                vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1120" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="lane_main" value="当前已实现主链"
                style="swimlane;html=1;whiteSpace=wrap;rounded=1;horizontal=1;startSize=32;container=1;collapsible=0;recursiveResize=0;strokeColor=#82B366;fillColor=#D5E8D4;fontStyle=1;pointerEvents=0;"
