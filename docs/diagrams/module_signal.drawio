<mxfile host="app.diagrams.net" modified="2026-03-29T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="signal-module" name="signal/ — 扩频、多星叠加与辅助信号">
    <mxGraphModel dx="1800" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="940" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="signal/ 模块 — `spreader.py`、`multi_sat_combiner.py` 与 helper 的真实分工"
                style="text;html=1;fontStyle=1;fontSize=15;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1500" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="lane_spread" value="单星扩频主链 — `spreader.py`"
                style="swimlane;html=1;whiteSpace=wrap;rounded=1;horizontal=1;startSize=32;container=1;collapsible=0;recursiveResize=0;strokeColor=#82B366;fillColor=#D5E8D4;fontStyle=1;pointerEvents=0;"
                vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="500" height="820" as="geometry"/>
        </mxCell>
        <mxCell id="lane_multi" value="多星叠加 — `multi_sat_combiner.py`"
                style="swimlane;html=1;whiteSpace=wrap;rounded=1;horizontal=1;startSize=32;container=1;collapsible=0;recursiveResize=0;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontStyle=1;pointerEvents=0;"
                vertex="1" parent="1">
          <mxGeometry x="540" y="60" width="500" height="820" as="geometry"/>
        </mxCell>
        <mxCell id="lane_helpers" value="辅助函数 — `iq_builder.py` / `modulator.py`"
                style="swimlane;html=1;whiteSpace=wrap;rounded=1;horizontal=1;startSize=32;container=1;collapsible=0;recursiveResize=0;strokeColor=#D79B00;fillColor=#FFF2CC;fontStyle=1;pointerEvents=0;"
                vertex="1" parent="1">
          <mxGeometry x="1060" y="60" width="470" height="820" as="geometry"/>
        </mxCell>

        <mxCell id="spread_in" value="输入配置&#xa;`prn_id` / `samples_per_chip` / `amplitude`&#xa;`nav_pattern` / `initial_code_phase`&#xa;`initial_nav_epoch` / `initial_nav_bit_index`"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;"
                vertex="1" parent="lane_spread">
          <mxGeometry x="40" y="55" width="420" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="state" value="状态结构&#xa;`GeneratorState`&#xa;`code_phase` / `nav_epoch_in_bit`&#xa;`nav_bit_index` / `sample_phase_in_chip`"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;"
                vertex="1" parent="lane_spread">
          <mxGeometry x="85" y="185" width="330" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="spread_cls" value="核心实现&#xa;`GpsL1CaBpskGenerator`"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82B366;strokeColor=#4D7A3A;fontColor=#ffffff;fontStyle=1;"
                vertex="1" parent="lane_spread">
          <mxGeometry x="140" y="300" width="220" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="chip_logic" value="chip 级逻辑&#xa;当前导航 bit × 当前 C/A chip&#xa;通过 `_advance_chip()` 推进三层时间尺度"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;"
                vertex="1" parent="lane_spread">
          <mxGeometry x="85" y="390" width="330" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="gen_chips" value="接口 1&#xa;`generate_chips(num_chips)`&#xa;输出: `np.int8[N]`"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;"
                vertex="1" parent="lane_spread">
          <mxGeometry x="85" y="495" width="330" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="gen_samples" value="接口 2&#xa;`generate_samples(num_samples)`&#xa;直接按当前状态写出 `complex64` BPSK 样本&#xa;`real = ±amplitude`，`imag = 0`"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82B366;strokeColor=#4D7A3A;fontColor=#ffffff;fontStyle=1;"
                vertex="1" parent="lane_spread">
          <mxGeometry x="85" y="590" width="330" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="samples_out" value="输出产物&#xa;`np.complex64[M]`&#xa;单星 replay buffer 的直接来源"
                style="shape=document;whiteSpace=wrap;html=1;fillColor=#FCE5CD;strokeColor=#D79B00;fontStyle=1;"
                vertex="1" parent="lane_spread">
          <mxGeometry x="140" y="715" width="220" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="spread_note" value="关键说明&#xa;当前单星运行时由 `GpsL1CaBpskGenerator.generate_samples()` 直接生成 `complex64`。&#xa;它不会在主链中先显式调用 `repeat_chips()` 或 `chips_to_complex_baseband()`。"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=10;"
                vertex="1" parent="lane_spread">
          <mxGeometry x="35" y="715" width="90" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="multi_in" value="输入配置&#xa;`prn_ids: Sequence[int] | None`&#xa;`samples_per_chip` / `nav_pattern` / `normalize=True`&#xa;`None` → `SUPPORTED_PRN_IDS` 全 32 颗"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;"
                vertex="1" parent="lane_multi">
          <mxGeometry x="40" y="55" width="420" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="multi_loop" value="逐星生成&#xa;对每个 `prn_id` 构造 `GpsL1CaBpskGenerator(..., amplitude=1.0)`&#xa;生成等长 per-PRN `complex64` buffer"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;"
                vertex="1" parent="lane_multi">
          <mxGeometry x="85" y="190" width="330" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="multi_sum" value="线性叠加&#xa;`combined += per_prn_buffer`&#xa;类型保持为 `np.complex64`"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;"
                vertex="1" parent="lane_multi">
          <mxGeometry x="85" y="315" width="330" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="multi_norm" value="功率归一化&#xa;若 `normalize` 且 `N &gt; 1`&#xa;执行 `combined /= sqrt(N)`&#xa;保持平均功率近似单星等效"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;"
                vertex="1" parent="lane_multi">
          <mxGeometry x="85" y="420" width="330" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="multi_func" value="核心实现&#xa;`build_multi_sat_replay_samples(...)`"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6C8EBF;strokeColor=#4E6E9C;fontColor=#ffffff;fontStyle=1;"
                vertex="1" parent="lane_multi">
          <mxGeometry x="140" y="540" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="multi_out" value="输出产物&#xa;`np.complex64[L]`&#xa;长度 = `len(nav_bits) × 20 × 1023 × spc`&#xa;供 GNU Radio `vector_source_c(repeat=True)` 回放"
                style="shape=document;whiteSpace=wrap;html=1;fillColor=#FCE5CD;strokeColor=#D79B00;fontStyle=1;"
                vertex="1" parent="lane_multi">
          <mxGeometry x="110" y="640" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="multi_note" value="当前约束&#xa;所有 PRN 共享同一个 `nav_pattern`。&#xa;每路 `initial_*` 相位默认都从 0 起步。"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=10;"
                vertex="1" parent="lane_multi">
          <mxGeometry x="110" y="760" width="280" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="tone_func" value="`iq_builder.py`&#xa;`generate_complex_tone(sample_rate, tone_freq, duration_s, amplitude)`&#xa;用途: 单音校准基带"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6B656;strokeColor=#B09533;fontColor=#ffffff;fontStyle=1;"
                vertex="1" parent="lane_helpers">
          <mxGeometry x="45" y="75" width="380" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="tone_out" value="输出产物&#xa;`np.complex64[N]`&#xa;`x[n] = A · exp(j 2π f n / fs)`"
                style="shape=document;whiteSpace=wrap;html=1;fillColor=#FCE5CD;strokeColor=#D79B00;fontStyle=1;"
                vertex="1" parent="lane_helpers">
          <mxGeometry x="110" y="185" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="helper_divider" value=""
                style="line;strokeColor=#D79B00;fillColor=none;"
                vertex="1" parent="lane_helpers">
          <mxGeometry x="55" y="295" width="360" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="mod_func" value="`modulator.py`&#xa;`chips_to_complex_baseband(chips, amplitude)`&#xa;用途: 概念上的 chip→complex BPSK 映射 helper"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;"
                vertex="1" parent="lane_helpers">
          <mxGeometry x="45" y="335" width="380" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="mod_out" value="输出产物&#xa;`np.complex64[N]`&#xa;`real = ±amplitude`，`imag = 0`"
                style="shape=document;whiteSpace=wrap;html=1;fillColor=#FCE5CD;strokeColor=#D79B00;fontStyle=1;"
                vertex="1" parent="lane_helpers">
          <mxGeometry x="110" y="445" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="helper_note" value="修正后的归属&#xa;`iq_builder.py` 画单音，`modulator.py` 画 chip→complex。&#xa;旧图这两者的职责是写反的。"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;"
                vertex="1" parent="lane_helpers">
          <mxGeometry x="80" y="555" width="310" height="75" as="geometry"/>
        </mxCell>

