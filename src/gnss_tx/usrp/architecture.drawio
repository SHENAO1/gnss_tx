                <mxCell id="usrp-sink" value="uhd.usrp_sink (USRP B210)&#xa;设置: sample_rate, center_freq&#xa;      tx_gain, antenna, bandwidth" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="500" y="900" width="230" height="70" as="geometry"/>
