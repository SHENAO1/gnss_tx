<mxfile host="65bd71144e">
    <diagram id="usrp-module" name="usrp/ — USRP 配置与控制模块">
        <mxGraphModel dx="1351" dy="1209" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="860" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="usrp/ 模块 — 运行时配置管理与 USRP B210 硬件接口 (tx_controller.py + b210_sink.py)" style="text;html=1;fontStyle=1;fontSize=14;align=center;" parent="1" vertex="1">
                    <mxGeometry x="50" y="10" width="1100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="in-yaml" value="输入: YAML 文件路径 (str | Path)&#xa;configs/tx_b210*.yaml" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="300" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="load-yaml" value="load_yaml_file(path)&#xa;→ dict[str, Any]  [来自 utils/io.py]" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="145" width="300" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="load-config" value="load_tx_runtime_config(path) → TxRuntimeConfig&#xa;tx_controller.py&#xa;派生规则: sample_rate = 1.023e6 × spc (若未填)&#xa;         bandwidth = sample_rate (若未填)" style="rounded=1;whiteSpace=wrap;fillColor=#82b366;strokeColor=#4d7a3a;fontColor=#ffffff;fontStyle=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="230" width="300" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="runtime-cfg" value="TxRuntimeConfig  @dataclass(frozen=True)&#xa;──────────────────────────────────&#xa;prn_id: int           signal_mode: str&#xa;usrp_addr: str        center_freq: float&#xa;sample_rate: float    samples_per_chip: int&#xa;tx_gain: float|None   amplitude: float&#xa;antenna: str          bandwidth: float|None&#xa;nav_pattern: str      tone_offset_hz: float&#xa;tone_buffer_s: float  duration_s: float|None&#xa;continuous: bool      enable_qt_preview: bool&#xa;initial_code_phase / nav_epoch / nav_bit_index" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="345" width="300" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="validate" value=".validate() → TxRuntimeConfig&#xa;检查: signal_mode ∈ {spread, tone}&#xa;      prn_id ∈ SUPPORTED_PRN_IDS&#xa;      sample_rate == 1.023e6 × spc (spread)&#xa;      |tone_offset| &lt; sample_rate/2 (tone)&#xa;失败: 抛出 ValueError" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="570" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="to-block" value=".to_block_config() → TxBlockConfig&#xa;转换为 GNU Radio 块所需格式" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="700" width="300" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="block-cfg" value="TxBlockConfig  @dataclass&#xa;─────────────────────────&#xa;all_prns: bool    prn_ids: list|None&#xa;signal_mode, spc, amplitude, ...&#xa;(传入 GpsL1CaTxTopBlock)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="790" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="in-cli" value="输入: CLI 覆盖参数 **kwargs&#xa;(--prn-id, --center-freq, ...)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="490" y="315" width="230" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="apply-overrides" value="apply_overrides(config, **kwargs)&#xa;→ TxRuntimeConfig&#xa;tx_controller.py&#xa;处理参数联动 (sample_rate ↔ spc)" style="rounded=1;whiteSpace=wrap;fillColor=#82b366;strokeColor=#4d7a3a;fontColor=#ffffff;fontStyle=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="490" y="400" width="230" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="create-sink" value="create_b210_sink(config: TxBlockConfig)&#xa;b210_sink.py&#xa;→ uhd.usrp_sink" style="rounded=1;whiteSpace=wrap;fillColor=#82b366;strokeColor=#4d7a3a;fontColor=#ffffff;fontStyle=1;fontSize=10;" parent="1" vertex="1">
