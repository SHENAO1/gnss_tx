<mxfile host="app.diagrams.net" modified="2026-03-29T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="ca-module" name="ca/ — C/A 码生成与重采样">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="760" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="ca/ 模块 — `prn_generator.py` + `resampler.py` 的真实职责"
                style="text;html=1;fontStyle=1;fontSize=15;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1120" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="lane_prn" value="C/A 码生成"
                style="swimlane;html=1;whiteSpace=wrap;rounded=1;horizontal=1;startSize=32;container=1;collapsible=0;recursiveResize=0;strokeColor=#82B366;fillColor=#D5E8D4;fontStyle=1;pointerEvents=0;"
                vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="520" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="lane_resample" value="chip→sample 展开"
                style="swimlane;html=1;whiteSpace=wrap;rounded=1;horizontal=1;startSize=32;container=1;collapsible=0;recursiveResize=0;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontStyle=1;pointerEvents=0;"
                vertex="1" parent="1">
          <mxGeometry x="590" y="60" width="520" height="520" as="geometry"/>
        </mxCell>

        <mxCell id="prn_in" value="输入配置&#xa;`prn_id: int`&#xa;约束: `SUPPORTED_PRN_IDS = 1..32`"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;"
                vertex="1" parent="lane_prn">
          <mxGeometry x="30" y="50" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="lfsr_note" value="算法含义&#xa;G1 / G2 两个 10-bit LFSR&#xa;按 `_PRN_G2_TAPS[prn_id]` 选择 G2 抽头"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=10;"
                vertex="1" parent="lane_prn">
          <mxGeometry x="270" y="50" width="210" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="g1" value="G1 寄存器推进&#xa;输出: `g1[9]`&#xa;反馈: `g1[2] ^ g1[9]`"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;"
                vertex="1" parent="lane_prn">
          <mxGeometry x="30" y="155" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="G2 寄存器推进&#xa;输出: `g2[tap_a-1] ^ g2[tap_b-1]`&#xa;反馈: 6 抽头异或"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;"
                vertex="1" parent="lane_prn">
          <mxGeometry x="270" y="155" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="xor" value="chip 判决&#xa;`g1_out ^ g2_out`&#xa;0 → `+1`，1 → `-1`"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;"
                vertex="1" parent="lane_prn">
          <mxGeometry x="145" y="260" width="220" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="gen_ca" value="核心实现&#xa;`generate_ca_code(prn_id)`&#xa;文件: `prn_generator.py`"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82B366;strokeColor=#4D7A3A;fontColor=#ffffff;fontStyle=1;"
                vertex="1" parent="lane_prn">
          <mxGeometry x="145" y="360" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ca_out" value="输出产物&#xa;`np.int8[CA_CODE_LENGTH]`&#xa;长度 = `1023`&#xa;值域 = `{-1, +1}`&#xa;对应 1 ms C/A epoch"
                style="shape=document;whiteSpace=wrap;html=1;fillColor=#FCE5CD;strokeColor=#D79B00;fontStyle=1;"
                vertex="1" parent="lane_prn">
          <mxGeometry x="145" y="455" width="220" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="repeat_in" value="输入配置&#xa;`chips: np.int8[N]`&#xa;`samples_per_chip: int &gt; 0`"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;"
                vertex="1" parent="lane_resample">
          <mxGeometry x="35" y="70" width="210" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="repeat_impl" value="实现逻辑&#xa;`np.repeat(chips, samples_per_chip)`&#xa;仅接受 1-D chip 序列&#xa;空输入返回空数组"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;"
                vertex="1" parent="lane_resample">
          <mxGeometry x="155" y="185" width="230" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="repeat_func" value="核心实现&#xa;`repeat_chips(chips, samples_per_chip)`&#xa;文件: `resampler.py`"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6C8EBF;strokeColor=#4E6E9C;fontColor=#ffffff;fontStyle=1;"
                vertex="1" parent="lane_resample">
          <mxGeometry x="155" y="300" width="230" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="repeat_out" value="输出产物&#xa;`np.int8[N × samples_per_chip]`&#xa;值域仍为 `{-1, +1}`&#xa;概念采样率: `1.023e6 × samples_per_chip`"
                style="shape=document;whiteSpace=wrap;html=1;fillColor=#FCE5CD;strokeColor=#D79B00;fontStyle=1;"
                vertex="1" parent="lane_resample">
          <mxGeometry x="155" y="400" width="230" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="repeat_note" value="用途说明&#xa;这是 chip 级辅助函数。&#xa;`signal/spreader.py` 的单星运行时会直接维护 chip/sample 状态，&#xa;不要求显式先调这里再生成 `complex64`。"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=10;"
                vertex="1" parent="lane_resample">
          <mxGeometry x="40" y="400" width="95" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="constants" value="关键约束&#xa;`CA_CODE_LENGTH = 1023`&#xa;`SUPPORTED_PRN_IDS = 1..32`&#xa;输出长度关系: `len(out) = len(chips) × samples_per_chip`"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;"
                vertex="1" parent="1">
          <mxGeometry x="320" y="610" width="500" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="prn_in" target="g1">
