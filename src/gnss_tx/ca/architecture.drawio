<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-03-26" version="21.0.0">
  <diagram id="ca-module" name="ca/ — C/A 码生成模块">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1"
                  tooltips="1" connect="1" arrows="1" fold="1" page="1"
                  pageScale="1" pageWidth="900" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="ca/ 模块 — GPS L1 C/A 码生成与重采样"
                style="text;html=1;fontStyle=1;fontSize=14;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="100" y="10" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== LEFT COLUMN: generate_ca_code ===== -->
        <mxCell id="in-prn" value="输入: prn_id: int&#xa;范围 1~32"
                style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="200" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="g1-lfsr" value="G1 LFSR (10-bit)&#xa;多项式: 1+x³+x¹⁰&#xa;初值: 1111111111"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="145" width="190" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="g2-lfsr" value="G2 LFSR (10-bit)&#xa;多项式: 1+x²+x³+x⁶+x⁸+x⁹+x¹⁰&#xa;抽头: _PRN_G2_TAPS[prn_id]"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="190" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="xor-op" value="XOR 组合&#xa;chip = G1[9] ⊕ G2[tap1] ⊕ G2[tap2]&#xa;双极性: 0→+1,  1→-1"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="345" width="190" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="func-ca" value="generate_ca_code(prn_id)&#xa;prn_generator.py"
                style="rounded=1;whiteSpace=wrap;fillColor=#82b366;strokeColor=#4d7a3a;fontColor=#ffffff;fontStyle=1;fontSize=11;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="445" width="190" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="out-ca" value="输出: np.int8[1023]&#xa;值域: {-1, +1}&#xa;1 ms C/A 码周期"
                style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="190" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== RIGHT COLUMN: repeat_chips ===== -->
        <mxCell id="in-chips" value="输入: chips: np.int8[N]&#xa;输入: samples_per_chip: int"
                style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="220" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="zoh" value="零阶保持（ZOH）重采样&#xa;np.repeat(chips, samples_per_chip)&#xa;每个 chip 重复 spc 次"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="480" y="145" width="220" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="func-resamp" value="repeat_chips(chips, samples_per_chip)&#xa;resampler.py"
                style="rounded=1;whiteSpace=wrap;fillColor=#82b366;strokeColor=#4d7a3a;fontColor=#ffffff;fontStyle=1;fontSize=11;"
                vertex="1" parent="1">
          <mxGeometry x="480" y="250" width="220" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="out-resamp" value="输出: np.int8[N × spc]&#xa;值域: {-1, +1}&#xa;sample_rate = 1.023e6 × spc"
                style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="480" y="340" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== CONSTANTS ===== -->
        <mxCell id="const-bg" value="模块常量"
                style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=11;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="660" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="CA_CODE_LENGTH = 1023"
                style="text;html=1;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="655" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="GPS_CA_CHIP_RATE = 1.023e6 chips/s"
                style="text;html=1;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="280" y="655" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="SUPPORTED_PRN_IDS = (1 … 32)"
                style="text;html=1;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="540" y="655" width="200" height="20" as="geometry"/>
        </mxCell>

        <!-- ===== EDGES left column ===== -->
        <mxCell id="el1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="in-prn" target="g1-lfsr" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="el2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="in-prn" target="g2-lfsr" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="el3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="g1-lfsr" target="xor-op" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="el4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="g2-lfsr" target="xor-op" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="el5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="xor-op" target="func-ca" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="el6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="func-ca" target="out-ca" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== EDGES right column ===== -->
        <mxCell id="er1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="in-chips" target="zoh" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="zoh" target="func-resamp" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="func-resamp" target="out-resamp" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Cross-reference arrow: ca output feeds repeat_chips -->
        <mxCell id="cross" value="ca_code 可作为 chips 输入"
                style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#aaaaaa;fontSize=9;"
                edge="1" source="out-ca" target="in-chips" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
