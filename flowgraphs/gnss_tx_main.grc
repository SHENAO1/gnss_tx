options:
  parameters:
    author: ''
    category: Custom
    cmake_opt: ''
    comment: 'PRN1 spread-spectrum continuous transmit mirror flowgraph for B210, QT preview, and lab bring-up.'
    copyright: ''
    description: ''
    gen_cmake: 'Off'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: gnss_tx_main
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: GNSS TX PRN1 B210
    window_size: 1800,1200
  states:
    coordinate: [8, 11]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 1.023e6 * samples_per_chip
  states:
    coordinate: [88, 72]
    rotation: 0
    state: enabled
- name: samples_per_chip
  id: variable
  parameters:
    comment: ''
    value: '4'
  states:
    coordinate: [88, 24]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: ''
    value: 100e6
  states:
    coordinate: [264, 24]
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: ''
    value: '0.0'
  states:
    coordinate: [264, 72]
    rotation: 0
    state: enabled
- name: amplitude
  id: variable
  parameters:
    comment: ''
    value: '1.0'
  states:
    coordinate: [440, 24]
    rotation: 0
    state: enabled
- name: usrp_addr
  id: variable
  parameters:
    comment: ''
    value: '"type=b200"'
  states:
    coordinate: [440, 72]
    rotation: 0
    state: enabled
- name: nav_pattern
  id: variable
  parameters:
    comment: ''
    value: '"1 0 1 1 0 0 1 0"'
  states:
    coordinate: [632, 24]
    rotation: 0
    state: enabled
- name: safety_note
  id: note
  parameters:
    comment: ''
    note: "PRN1 only. This flowgraph is a GNU Radio Companion mirror of the Python runtime transmit chain.\nThe custom source replays a precomputed spread-spectrum buffer continuously to reduce USRP underflows.\nSignal type: PRN1 GPS L1 C/A spread-spectrum BPSK complex baseband, not a tone and not a full GNSS navigation transmitter.\nInternal source amplitude stays at 1.0; RF strength is adjusted here with tx_gain and the output multiply_const block.\nCheck QT GUI time/frequency views before connecting the spectrum analyzer.\nAnalyzer max input: 30 dBm, 50 V DC, 50 ohm. Start with low tx_gain."
  states:
    coordinate: [840, 20]
    rotation: 0
    state: enabled
- name: prn_source
  id: gnss_tx_gps_l1_ca_source
  parameters:
    amplitude: '1.0'
    initial_code_phase: '0'
    initial_nav_bit_index: '0'
    initial_nav_epoch: '0'
    nav_pattern: nav_pattern
    prn_id: '1'
    samples_per_chip: samples_per_chip
  states:
    coordinate: [192, 272]
    rotation: 0
    state: enabled
- name: amplitude_scale
  id: blocks_multiply_const_vxx
  parameters:
    const: amplitude
    type: complex
    vlen: '1'
  states:
    coordinate: [432, 272]
    rotation: 0
    state: enabled
- name: qt_time
  id: qtgui_time_sink_x
  parameters:
    autoscale: 'False'
    axislabels: 'True'
    color1: blue
    color2: red
    ctrlpanel: 'False'
    entags: 'False'
    grid: 'True'
    gui_hint: 0,0,1,1
    label1: I
    label2: Q
    legend: 'True'
    name: '"PRN1 Baseband Time"'
    nconnections: '1'
    size: '512'
    srate: samp_rate
    stemplot: 'False'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    yunit: '""'
    ylabel: Amplitude
    ymax: '1.2'
    ymin: '-1.2'
  states:
    coordinate: [704, 216]
    rotation: 0
    state: enabled
- name: qt_freq
  id: qtgui_freq_sink_x
  parameters:
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    ctrlpanel: 'False'
    fc: center_freq
    fftsize: '2048'
    grid: 'True'
    gui_hint: 0,1,1,1
    label: Relative Gain
    label1: '"PRN1 RF Preview"'
    legend: 'True'
    name: '"PRN1 Baseband Spectrum"'
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.10'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '10'
    ymin: '-120'
  states:
    coordinate: [704, 376]
    rotation: 0
    state: enabled
